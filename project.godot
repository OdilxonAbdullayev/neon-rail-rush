; NEON RAIL RUSH - original 3D endless runner
config_version=5

[application]
config/name="Neon Rail Rush"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="An original neon city endless runner."
config/icon="res://assets/icon.png"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.035, 0.046, 0.1, 1)

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=420
window/size/window_height_override=747
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[physics]
3d/default_gravity=24.0

[audio]
buses/default_bus_layout="res://audio/default_bus_layout.tres"

[gui]
theme/default_font_multichannel_signed_distance_field=true
